<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>

  <!-- MAIN WINDOW -->
  <object class="GtkWindow" id="main_window">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">ETA Printer Manager</property>
    <property name="default-width">750</property>
    <property name="default-height">600</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="headerbar">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="title" translatable="yes">ETA Printer Manager</property>
        <property name="show-close-button">True</property>
        <!-- TOP LEFT: ABOUT US BUTTON -->
        <child>
          <object class="GtkButton" id="btn_about">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="tooltip-text" translatable="yes">About Us</property>
            <child>
              <object class="GtkImage" id="img_about">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="icon-name">dialog-information-symbolic</property>
              </object>
            </child>
            <style>
              <class name="top-icon-btn"/>
            </style>
          </object>
          <packing>
            <property name="pack-type">start</property>
          </packing>
        </child>
      </object>
    </child>
    <!-- MAIN BODY -->
    <child>
      <object class="GtkScrolledWindow" id="scroll_main">
        <property name="visible">True</property>
        <property name="can-focus">True</property>
        <child>
          <object class="GtkBox" id="main_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">0</property>
            <property name="margin-left">12</property>
            <property name="margin-right">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkLabel" id="lbl_main">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">ETA Printer Manager</property>
                <property name="xalign">0</property>
                <property name="margin-left">12</property>
                <style>
                  <class name="main-title"/>
                </style>
              </object>
            </child>
            <!-- ADD DEVICE CARD -->
            <child>
              <object class="GtkBox" id="add_card">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">16</property>
                <property name="margin-left">6</property>
                <property name="margin-right">6</property>
                <style>
                  <class name="add-device-card"/>
                </style>
                <child>
                  <object class="GtkBox" id="add_text_box">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkLabel" id="lbl_add_title">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">Add Device</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="card-title"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbl_add_sub">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">Add a printer or scanner on network or USB</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="card-subtitle"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_add_device">
                    <property name="label" translatable="yes">Add Device</property>
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <style>
                      <class name="btn-primary"/>
                    </style>
                  </object>
                  <packing>
                    <property name="pack-type">end</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_section">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Your Devices</property>
                <property name="xalign">0</property>
                <property name="margin-left">12</property>
                <style>
                  <class name="section-title"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="device_list_box">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <!-- ADD DEVICE DIALOG -->
  <object class="GtkDialog" id="add_device_dialog">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">Add Device</property>
    <property name="modal">True</property>
    <property name="default-width">540</property>
    <property name="default-height">520</property>
    <child type="action">
      <object class="GtkButton" id="btn_cancel">
        <property name="label" translatable="yes">Cancel</property>
        <property name="visible">True</property>
        <property name="can-focus">True</property>
        <style>
          <class name="btn-secondary"/>
        </style>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="btn_add">
        <property name="label" translatable="yes">Add</property>
        <property name="visible">True</property>
        <property name="can-focus">True</property>
        <style>
          <class name="btn-primary"/>
        </style>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-6">btn_cancel</action-widget>
      <action-widget response="-5">btn_add</action-widget>
    </action-widgets>
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog_vbox">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <child>
          <object class="GtkBox" id="vbox_main">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">14</property>
            <property name="margin-left">18</property>
            <property name="margin-right">18</property>
            <property name="margin-top">18</property>
            <property name="margin-bottom">18</property>
            <child>
              <object class="GtkLabel" id="lbl_manual">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Add Device Manually</property>
                <property name="xalign">0</property>
                <style>
                  <class name="card-title"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="grid_manual">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="row-spacing">10</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lbl_name">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Device Name:</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="card-subtitle"/>
                    </style>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="entry_name">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="placeholder-text" translatable="yes">e.g. Office_Printer</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_uri">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Connection Address (URI):</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="card-subtitle"/>
                    </style>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="entry_uri">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="placeholder-text" translatable="yes">e.g. ipp://192.168.1.50/ipp/print</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_driver">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Driver (PPD):</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="card-subtitle"/>
                    </style>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">2</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="hbox_driver">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="spacing">6</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkComboBoxText" id="combo_driver">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_browse_ppd">
                        <property name="label" translatable="yes">Browse PPD...</property>
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <style>
                          <class name="btn-secondary"/>
                        </style>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">2</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="separator1">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbox_auto_header">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="lbl_auto">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Devices Found on Network and System</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="card-title"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkSpinner" id="spinner_discovery">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scroll_discovered">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="min-content-height">180</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkListBox" id="listbox_discovered">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="selection-mode">single</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>